{
  "name": "txlens",
  "version": "0.1.0",
  "description": "Explain any Stellar transaction XDR in plain English and flag risky operations before you sign.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "txlens": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "keywords": [
    "stellar",
    "xdr",
    "transaction",
    "security",
    "wallet",
    "cli"
  ],
  "dependencies": {
    "@stellar/stellar-sdk": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.20.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}
